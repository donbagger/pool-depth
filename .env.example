# Everything here is optional. pool-depth works with no key at all.
# Load it into your shell with: set -a; . ./.env; set +a

# A free key from https://console.dexpaprika.com raises the rate limit.
# Paste the key on its own, nothing in front of it.
DEXPAPRIKA_API_KEY=

# Paid plans only. Leave it commented out on a free key.
# DEXPAPRIKA_BASE_URL=https://api-pro.dexpaprika.com
